# Adresse publique du service, sans barre finale. C'est l'adresse que tous les outils connaissent :
# la changer plus tard oblige à reconfigurer chaque outil et invalide les clés d'accès (Face ID, Touch ID).
COMPTE_URL=http://localhost:3000
# Le site public (la page d'accueil servie aussi sur postmelo.ch) : son formulaire de contact peut écrire ici.
SITE_URL=

# Secret du service (cookies, chiffrement des clés de signature et des secrets de double authentification).
# Obligatoire en production, 32 caractères au moins : openssl rand -base64 32
# Ne le change jamais une fois en service, et garde-en une copie (dans Cairn).
AUTH_SECRET=

# Dossier de la base SQLite
DATA_DIR=./data

# --- Les outils qui se connectent avec ce compte ---
# Un outil est branché quand il a son adresse ET son secret (32 caractères au moins, openssl rand -base64 32).
# Dans l'outil : COMPTE_URL (l'adresse ci-dessus), COMPTE_CLIENT_ID (lamio, cairn, metricove, tickup, alfred
# ou nino) et COMPTE_CLIENT_SECRET (le même secret). Voir docs/BRANCHER-UN-OUTIL.md.
LAMIO_URL=
LAMIO_CLIENT_SECRET=
CAIRN_URL=
CAIRN_CLIENT_SECRET=
METRICOVE_URL=
METRICOVE_CLIENT_SECRET=
TICKUP_URL=
TICKUP_CLIENT_SECRET=
ALFRED_URL=
ALFRED_CLIENT_SECRET=
NINO_URL=
NINO_CLIENT_SECRET=

# --- Paiement (Stripe) ---
# Sans clé, une inscription sur /tarifs démarre l'essai gratuit sans carte (formules avec essai seulement).
# Clé secrète : dashboard.stripe.com > Développeurs > Clés API. sk_test_… pour essayer sans vrai paiement.
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) : Développeurs > Webhooks > Ajouter un endpoint vers <COMPTE_URL>/api/stripe/webhook,
# avec les événements checkout.session.completed, customer.subscription.created / updated / deleted,
# invoice.paid et invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=

# "off" coupe les limites d'essais (5 connexions par minute et par adresse, compte verrouillé 15 min après
# 10 mots de passe faux). À ne jamais mettre en production. "on" les active hors production (tests).
RATE_LIMIT=
